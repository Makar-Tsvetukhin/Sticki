.upgrades-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
    background-color: rgba(12, 14, 18, 0.98);
    background-image: url("project://database/Assets/UI/Menu/БетонЫЫЫЫЫ.png");
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: flex-start;
}

.upgrades-header {
    align-items: center;
    justify-content: center;
    margin-top: 40px;
    width: 100%;
}

.upgrades-title {
    color: rgba(245, 245, 245, 0.98);
    font-size: 54px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.2);
    -unity-text-outline-width: 1px;
    margin-bottom: 8px;
}

.upgrades-title-underline {
    width: 340px;
    height: 2px;
    background-color: rgba(210, 70, 70, 0.9);
    margin-bottom: 10px;
}

.upgrades-subtitle {
    color: rgba(255, 255, 255, 0.62);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.upgrades-content {
    width: 100%;
    height: 66%;
    min-height: 460px;
    margin-top: 28px;
    padding-left: 90px;
    padding-right: 90px;
    align-items: stretch;
}

.upgrades-list {
    flex-grow: 1;
    width: 100%;
}

.upgrades-list .unity-scroll-view__horizontal-scroller {
    display: none;
}

.upgrades-list .unity-scroll-view__vertical-scroller {
    width: 12px;
    min-width: 12px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.12);
    margin-left: 8px;
}

.upgrades-list .unity-scroll-view__vertical-scroller .unity-scroller__low-button,
.upgrades-list .unity-scroll-view__vertical-scroller .unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

.upgrades-list .unity-scroll-view__vertical-scroller .unity-base-slider__tracker,
.upgrades-list .unity-scroll-view__vertical-scroller .unity-slider__track,
.upgrades-list .unity-scroll-view__vertical-scroller .unity-scroller__slider {
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    border-width: 0;
}

.upgrades-list .unity-scroll-view__vertical-scroller .unity-base-slider__dragger,
.upgrades-list .unity-scroll-view__vertical-scroller .unity-slider__dragger,
.upgrades-list .unity-scroll-view__vertical-scroller .unity-scroller__dragger {
    min-height: 44px;
    border-radius: 8px;
    background-color: rgba(210, 70, 70, 0.86);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.26);
}

.upgrades-list .unity-scroll-view__vertical-scroller .unity-base-slider__dragger-border,
.upgrades-list .unity-scroll-view__vertical-scroller .unity-scroller__dragger-border {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.upgrades-list .unity-scroll-view__vertical-scroller:hover .unity-base-slider__dragger,
.upgrades-list .unity-scroll-view__vertical-scroller:hover .unity-slider__dragger,
.upgrades-list .unity-scroll-view__vertical-scroller:hover .unity-scroller__dragger {
    background-color: rgba(210, 70, 70, 0.98);
}

.upgrades-list .unity-scroll-view__vertical-scroller:hover .unity-base-slider__tracker,
.upgrades-list .unity-scroll-view__vertical-scroller:hover .unity-slider__track,
.upgrades-list .unity-scroll-view__vertical-scroller:hover .unity-scroller__slider {
    background-color: rgba(255, 255, 255, 0.16);
}

.upgrades-list .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding-bottom: 20px;
}

.upgrade-card {
    width: 365px;
    min-height: 116px;
    margin-right: 18px;
    margin-bottom: 18px;
    padding: 10px 12px;
    background-color: rgba(8, 10, 14, 0.62);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 4px;
    flex-direction: row;
}

.upgrade-card--locked {
    background-color: rgba(6, 7, 10, 0.68);
    border-color: rgba(255, 255, 255, 0.08);
}

.upgrade-icon {
    width: 70px;
    height: 70px;
    min-width: 70px;
    min-height: 70px;
    border-radius: 4px;
    background-color: rgba(210, 70, 70, 0.2);
    border-width: 1px;
    border-color: rgba(210, 70, 70, 0.58);
    margin-right: 12px;
    margin-top: 2px;
}

.upgrade-icon--locked {
    background-color: rgba(0, 0, 0, 0.85);
    border-color: rgba(255, 255, 255, 0.16);
}

.upgrade-info {
    flex-grow: 1;
}

.upgrade-name {
    color: rgba(245, 245, 245, 0.96);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.upgrade-name--locked {
    color: rgba(255, 255, 255, 0.48);
}

.upgrade-meta {
    color: rgba(255, 255, 255, 0.56);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 6px;
}

.upgrade-description {
    color: rgba(255, 255, 255, 0.84);
    font-size: 13px;
    letter-spacing: 1px;
}

.upgrade-description--locked {
    color: rgba(255, 255, 255, 0.42);
}

.upgrades-footer {
    position: absolute;
    bottom: 50px;
    right: 80px;
    flex-direction: row;
}

.upgrades-button {
    width: 190px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.95);
    font-size: 16px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
}

.upgrades-button:hover {
    scale: 1.03;
    color: rgba(255, 255, 255, 1);
    border-bottom-color: rgba(210, 70, 70, 1);
}

