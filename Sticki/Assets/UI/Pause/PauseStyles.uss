.pause-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.pause-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
}

.pause-content {
    width: 520px;
    padding: 20px 24px 24px 24px;
    align-items: center;
}

.pause-title {
    color: rgba(245, 245, 245, 0.98);
    font-size: 58px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    margin-bottom: 10px;
}

.pause-title-underline {
    width: 260px;
    height: 2px;
    background-color: rgba(210, 70, 70, 0.95);
    margin-bottom: 30px;
}

.pause-buttons {
    width: 100%;
    align-items: center;
}

.pause-button {
    width: 460px;
    height: 62px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.96);
    font-size: 26px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
    transition-duration: 0.18s;
}

.pause-button:hover,
.pause-button:focus {
    color: rgba(255, 255, 255, 1);
    border-bottom-color: rgba(210, 70, 70, 1);
    scale: 1.02;
}

.pause-button--last {
    margin-bottom: 0;
}
