.howto-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
    background-color: rgba(12, 14, 18, 0.98);
    background-image: url("project://database/Assets/UI/Menu/БетонЫЫЫЫЫ.png");
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: flex-start;
}

.howto-header {
    align-items: center;
    justify-content: center;
    margin-top: 40px;
    width: 100%;
}

.howto-title {
    color: rgba(245, 245, 245, 0.98);
    font-size: 54px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.2);
    -unity-text-outline-width: 1px;
    margin-bottom: 8px;
}

.howto-title-underline {
    width: 250px;
    height: 2px;
    background-color: rgba(210, 70, 70, 0.9);
}

.howto-content {
    width: 100%;
    height: 66%;
    min-height: 460px;
    margin-top: 32px;
    padding-left: 90px;
    padding-right: 90px;
}

.howto-scroll {
    flex-grow: 1;
    width: 100%;
}

.howto-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}

.howto-scroll .unity-scroll-view__vertical-scroller {
    width: 12px;
    min-width: 12px;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(255, 255, 255, 0.12);
    margin-left: 8px;
}

.howto-scroll .unity-scroll-view__vertical-scroller .unity-scroller__low-button,
.howto-scroll .unity-scroll-view__vertical-scroller .unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

.howto-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__tracker,
.howto-scroll .unity-scroll-view__vertical-scroller .unity-slider__track,
.howto-scroll .unity-scroll-view__vertical-scroller .unity-scroller__slider {
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    border-width: 0;
}

.howto-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__dragger,
.howto-scroll .unity-scroll-view__vertical-scroller .unity-slider__dragger,
.howto-scroll .unity-scroll-view__vertical-scroller .unity-scroller__dragger {
    min-height: 44px;
    border-radius: 8px;
    background-color: rgba(210, 70, 70, 0.86);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.26);
}

.howto-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__dragger-border,
.howto-scroll .unity-scroll-view__vertical-scroller .unity-scroller__dragger-border {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.howto-scroll .unity-scroll-view__vertical-scroller:hover .unity-base-slider__dragger,
.howto-scroll .unity-scroll-view__vertical-scroller:hover .unity-slider__dragger,
.howto-scroll .unity-scroll-view__vertical-scroller:hover .unity-scroller__dragger {
    background-color: rgba(210, 70, 70, 0.98);
}

.howto-scroll .unity-scroll-view__vertical-scroller:hover .unity-base-slider__tracker,
.howto-scroll .unity-scroll-view__vertical-scroller:hover .unity-slider__track,
.howto-scroll .unity-scroll-view__vertical-scroller:hover .unity-scroller__slider {
    background-color: rgba(255, 255, 255, 0.16);
}

.howto-scroll .unity-scroll-view__content-container {
    padding-bottom: 20px;
}

.howto-section {
    margin-bottom: 26px;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.14);
}

.howto-section-title {
    color: rgba(255, 255, 255, 0.95);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.howto-paragraph {
    color: rgba(255, 255, 255, 0.84);
    font-size: 17px;
}

.howto-line {
    color: rgba(255, 255, 255, 0.84);
    font-size: 17px;
    margin-bottom: 3px;
}

.howto-footer {
    position: absolute;
    bottom: 50px;
    right: 80px;
    flex-direction: row;
}

.howto-button {
    width: 190px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.95);
    font-size: 16px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
}

.howto-button:hover {
    scale: 1.03;
    color: rgba(255, 255, 255, 1);
    border-bottom-color: rgba(210, 70, 70, 1);
}

