.settings-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
    background-color: rgba(12, 14, 18, 0.98);
    background-image: url("project://database/Assets/UI/Menu/БетонЫЫЫЫЫ.png");
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: flex-start;
}

.settings-header {
    align-items: center;
    justify-content: center;
    margin-top: 40px;
    width: 100%;
}

.settings-title {
    color: rgba(245, 245, 245, 0.98);
    font-size: 54px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.2);
    -unity-text-outline-width: 1px;
    margin-bottom: 8px;
}

.settings-title-underline {
    width: 200px;
    height: 2px;
    background-color: rgba(210, 70, 70, 0.9);
}

.settings-content {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    width: 100%;
    margin-top: 32px;
    padding-left: 90px;
    padding-right: 90px;
    height: 66%;
    min-height: 460px;
}

.settings-nav {
    width: 300px;
    min-width: 300px;
    margin-left: 24px;
    margin-right: 64px;
    padding-top: 22px;
    align-items: flex-start;
    justify-content: center;
}

.nav-button {
    width: 290px;
    height: 64px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(255, 255, 255, 0.15);
    color: rgba(235, 240, 245, 0.7);
    font-size: 22px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 14px;
    margin-bottom: 22px;
    transition-duration: 0.2s;
}

.nav-button.is-active {
    color: rgba(255, 255, 255, 1);
    border-left-color: rgba(210, 70, 70, 1);
}

.nav-button:hover {
    scale: 1.03;
    color: rgba(255, 255, 255, 1);
    border-left-color: rgba(210, 70, 70, 1);
}

.nav-button--last {
    margin-bottom: 0;
}

.settings-panels {
    flex-grow: 1;
    min-width: 760px;
    max-width: 980px;
    height: 100%;
    align-items: stretch;
    justify-content: center;
}

.settings-panel {
    width: 100%;
    height: 100%;
    align-items: stretch;
}

.panel-title {
    color: rgba(255, 255, 255, 0.95);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 8px;
    margin-left: 72px;
}

.panel-rows {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: space-evenly;
    padding-top: 8px;
    padding-bottom: 12px;
}

.panel-row {
    width: 100%;
    max-width: 900px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.panel-label {
    color: rgba(255, 255, 255, 0.75);
    font-size: 20px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    width: 320px;
    margin-right: 18px;
}

.panel-control {
    width: 420px;
    min-width: 420px;
    height: 44px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

.panel-control--slider {
    justify-content: flex-start;
    align-items: center;
}

.panel-slider {
    width: 300px;
    height: auto;
    min-height: 0;
    margin-top: 0;
    margin-bottom: 0;
    align-self: center;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
}

.panel-toggle {
    width: 74px;
    height: 36px;
}

.panel-dropdown {
    width: 300px;
    height: 40px;
    min-height: 40px;
    align-self: center;
    background-color: rgba(255, 255, 255, 0.045);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 2px;
    color: rgba(245, 245, 245, 0.96);
    -unity-text-align: middle-left;
    padding-left: 10px;
    padding-right: 8px;
    font-size: 17px;
    -unity-font-style: bold;
}

.panel-value {
    width: 72px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 24px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    margin-left: 8px;
}

.panel-value--editable {
}

.panel-value--editable:hover {
    color: rgba(255, 255, 255, 1);
}

.panel-value-input {
    width: 72px;
    height: 32px;
    margin-left: 8px;
    padding-left: 6px;
    padding-right: 6px;
    color: rgba(255, 255, 255, 0.96);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1px;
    border-color: rgba(210, 70, 70, 0.8);
    border-radius: 2px;
}

.panel-value-input .unity-base-text-field__input,
.panel-value-input .unity-text-field__input {
    margin: 0;
    padding: 0;
    color: rgba(255, 255, 255, 0.96);
    -unity-text-align: middle-right;
    background-color: rgba(0, 0, 0, 0);
}

.bind-button {
    width: 200px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.9);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.bind-button:hover {
    scale: 1.03;
    color: rgba(255, 255, 255, 1);
    border-bottom-color: rgba(210, 70, 70, 1);
}

.is-hidden {
    display: none;
}

.settings-footer {
    position: absolute;
    bottom: 50px;
    right: 80px;
    flex-direction: row;
}

.footer-button {
    width: 180px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.95);
    font-size: 16px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-left: 16px;
    transition-duration: 0.2s;
}

.footer-button:hover {
    scale: 1.03;
    color: rgba(255, 255, 255, 1);
    border-bottom-color: rgba(210, 70, 70, 1);
}

.footer-button--secondary {
    color: rgba(255, 255, 255, 0.75);
}

.panel-slider .unity-base-field__label {
    display: none;
}

.panel-slider .unity-slider__track,
.panel-slider .unity-base-slider__tracker {
    height: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.panel-slider .unity-slider__progress {
    background-color: rgba(210, 70, 70, 0.95);
    border-radius: 4px;
}

.panel-slider .unity-slider__handle,
.panel-slider .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgba(22, 26, 33, 0.96);
    border-width: 1px;
    border-color: rgba(236, 240, 245, 0.92);
    margin-top: -6px;
}


.panel-slider .unity-base-slider__dragger-border {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.panel-slider .unity-base-slider__input {
    margin: 0;
    padding: 0;
}

.panel-slider:hover .unity-slider__track,
.panel-slider:hover .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.2);
    border-color: rgba(210, 70, 70, 0.35);
}

.panel-slider:hover .unity-slider__handle,
.panel-slider:hover .unity-base-slider__dragger {
    background-color: rgba(32, 38, 46, 0.98);
    border-color: rgba(210, 70, 70, 0.95);
}

.panel-dropdown {
    transition-duration: 0.12s;
}

.panel-dropdown:hover {
    border-color: rgba(210, 70, 70, 0.72);
    background-color: rgba(255, 255, 255, 0.065);
}

.panel-dropdown:focus {
    border-color: rgba(210, 70, 70, 0.95);
}

.panel-dropdown .unity-base-popup-field__input,
.panel-dropdown .unity-popup-field__input {
    margin-left: 0;
    padding-left: 2px;
    padding-right: 2px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.panel-dropdown .unity-base-popup-field__text,
.panel-dropdown .unity-popup-field__text {
    color: rgba(245, 245, 245, 0.96);
    font-size: 16px;
    -unity-font-style: bold;
}

.panel-dropdown .unity-base-popup-field__arrow,
.panel-dropdown .unity-popup-field__arrow {
    -unity-background-image-tint-color: rgba(210, 70, 70, 0.9);
}

.panel-toggle {
    background-color: rgba(0, 0, 0, 0);
    width: 78px;
    height: 34px;
    align-items: center;
    justify-content: flex-start;
}

.panel-toggle .unity-toggle__input {
    width: 66px;
    height: 30px;
    min-width: 66px;
    min-height: 30px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.24);
    background-color: rgba(20, 24, 30, 0.55);
    border-radius: 15px;
    padding-left: 4px;
    padding-right: 4px;
    align-items: center;
    justify-content: flex-start;
    transition-duration: 0.2s;
}

.panel-toggle .unity-toggle__checkmark {
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    border-radius: 10px;
    background-color: rgba(236, 240, 245, 0.98);
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(15, 18, 24, 0.38);
}

.panel-toggle:hover .unity-toggle__input {
    border-color: rgba(210, 70, 70, 0.55);
    background-color: rgba(28, 32, 39, 0.72);
}

.panel-toggle:checked .unity-toggle__input,
.panel-toggle .unity-toggle__input:checked {
    border-color: rgba(210, 70, 70, 0.95);
    background-color: rgba(210, 70, 70, 0.36);
    justify-content: flex-end;
}

.panel-toggle:checked .unity-toggle__checkmark,
.panel-toggle .unity-toggle__input:checked .unity-toggle__checkmark {
    background-color: rgba(250, 251, 252, 1);
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
}
